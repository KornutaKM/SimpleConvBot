# Copy to .env for local development. Never commit real secrets.
#
# Docker Compose reads .env automatically. A host-side `python -m simpleconvbot`
# process does not; export the same variables in that shell when running outside Compose.
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# Host-side application connection URLs. The Compose app profile overrides these
# with service-local postgres/redis hostnames.
DATABASE_URL=postgresql+asyncpg://simpleconvbot:replace-me-local-only@localhost:5432/simpleconvbot
REDIS_URL=redis://localhost:6379/0

TEMP_ROOT=./var/jobs
TEMP_TTL_SECONDS=3600
RETENTION_SWEEP_INTERVAL_SECONDS=60
DIAGNOSTICS_INTERVAL_SECONDS=300
WORKSPACE_MAX_BYTES=67108864
UPDATE_RATE_LIMIT_PER_MINUTE=60
MAX_ACTIVE_JOBS_PER_USER=3
MAX_ACTIVE_JOBS_GLOBAL=32

POSTGRES_DB=simpleconvbot
POSTGRES_USER=simpleconvbot
POSTGRES_PASSWORD=replace-me-local-only
