# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

DATABASE_URL=postgresql+asyncpg://simpleconvbot:replace-me-local-only@localhost:5432/simpleconvbot
REDIS_URL=redis://localhost:6379/0

TEMP_ROOT=./var/jobs
TEMP_TTL_SECONDS=3600
WORKSPACE_MAX_BYTES=67108864
UPDATE_RATE_LIMIT_PER_MINUTE=60
MAX_ACTIVE_JOBS_PER_USER=3
MAX_ACTIVE_JOBS_GLOBAL=32

POSTGRES_DB=simpleconvbot
POSTGRES_USER=simpleconvbot
POSTGRES_PASSWORD=replace-me-local-only
